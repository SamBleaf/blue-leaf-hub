{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://blue-leaf-hub-production.up.railway.app/api/:path*"
    },
    {
      "source": "/worker",
      "destination": "/worker.html"
    },
    {
      "source": "/worker/:path*",
      "destination": "/worker.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
