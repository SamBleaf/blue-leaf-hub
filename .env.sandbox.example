# ============================================================
#  Blue Leaf Hub — SANDBOX / STAGING ENVIRONMENT TEMPLATE
#  Marketing Command Centre Batch 4 smoke verification
# ============================================================
#
#  COPY THIS FILE to .env.sandbox (or .env.staging) and fill in
#  STAGING-ONLY values. .env.sandbox is gitignored (.env.*).
#
#  NEVER paste production credentials here.
#  NEVER commit a file with real secret values.
#  The smoke harness reads this file ONLY if you explicitly pass
#  --env-file=.env.sandbox as a CLI argument.
#
#  For each group, the comment describes the STAGING-SAFE setting.
#  Leave integration groups blank unless instructed otherwise —
#  the app degrades gracefully to no-op / demo mode.
# ============================================================


# ------------------------------------------------------------
#  SUPABASE — STAGING PROJECT (server-side)
#  Must be a DEDICATED non-production Supabase project.
#  Never the production project ref or URL.
# ------------------------------------------------------------
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# Used by the optional migration apply script (not required for smoke):
SUPABASE_DB_PASSWORD=YOUR_STAGING_DATABASE_PASSWORD


# ------------------------------------------------------------
#  SUPABASE — STAGING PROJECT (frontend / Vite)
#  Must match the same staging project above.
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY


# ------------------------------------------------------------
#  APP / API URL
#  Point to the staging API host (local or Railway staging).
#  Never a production Railway service or domain.
# ------------------------------------------------------------
VITE_API_URL=http://localhost:8787
# If running against a Railway staging deploy:
# VITE_API_URL=https://YOUR_STAGING_RAILWAY_SERVICE.up.railway.app


# ------------------------------------------------------------
#  AI — ANTHROPIC (optional for smoke)
#  Option A: A low-limit test key → exercises real AI generation.
#  Option B: Leave blank → all AI flows fall back to demo drafts.
#  Do NOT use a production key with high rate limits here.
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Use a lightweight model for test runs to limit cost/latency.
# Leave ANTHROPIC_API_KEY blank for a demo-only smoke (recommended first pass).


# ------------------------------------------------------------
#  EMAIL / RESEND / SMTP — SINK or BLANK
#  Marketing smoke does not send campaign emails.
#  Leave blank unless testing email delivery specifically.
#  If testing: use an Ethereal or Mailtrap sink, never Resend prod.
# ------------------------------------------------------------
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ------------------------------------------------------------
#  GMAIL / IMAP — BLANK (marketing has no inbound mail dependency)
# ------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
IMAP_HOST=
IMAP_PORT=
IMAP_SECURE=
IMAP_USER=
IMAP_PASS=


# ------------------------------------------------------------
#  BUILDEXACT — BLANK (marketing does not call Buildexact)
# ------------------------------------------------------------
BUILDEXACT_API_URL=
BUILDEXACT_USERNAME=
BUILDEXACT_API_KEY=
BUILDEXACT_SUBSCRIPTION_KEY=


# ------------------------------------------------------------
#  DROPBOX — BLANK (marketing media uses Supabase Storage, not Dropbox)
# ------------------------------------------------------------
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_NAMESPACE_ID=


# ------------------------------------------------------------
#  META / FACEBOOK — BLANK (no live social publishing in smoke scope)
# ------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=


# ------------------------------------------------------------
#  GOOGLE (GA4 / Search Console / GBP) — BLANK
#  The legacy SEO intelligence module (marketingIntelligenceRoutes)
#  uses these. Leave blank — it degrades gracefully.
# ------------------------------------------------------------
GA4_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GBP_LOCATION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=


# ------------------------------------------------------------
#  SAFETY FLAGS (optional)
#  These are not currently wired into the app, but are reserved
#  as documentation of the intent when running in sandbox mode.
# ------------------------------------------------------------
# SANDBOX_MODE=true        # Documents that this is a sandbox run
# DISABLE_EXTERNAL_APIS=true  # Reminder to leave integrations blank
# LOG_LEVEL=debug          # Increase verbosity for smoke verification
